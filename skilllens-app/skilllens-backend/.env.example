# ==============================================================================
# SkillLens Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or export these variables in your deployment environment.

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/skilllens_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# JWT Security (Must be at least 64 characters for HMAC-SHA512)
JWT_SECRET=super_secret_jwt_signing_key_for_skilllens_platform_must_be_at_least_64_bytes_long_change_me_in_prod
JWT_ACCESS_EXPIRY_MS=900000       # 15 minutes in milliseconds
JWT_REFRESH_EXPIRY_MS=604800000   # 7 days in milliseconds

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Initial Provisioning (Optional override on first startup)
ADMIN_INIT_EMAIL=admin@skilllens.com
ADMIN_INIT_PASSWORD=Admin@12345

# Google Cloud Storage (Set GCS_ENABLED=true for GCS; false uses LOCAL_STORAGE_DIR)
GCS_ENABLED=false
GCS_PROJECT_ID=
GCS_BUCKET_NAME=skilllens-resumes
GCS_CREDENTIALS_PATH=
LOCAL_STORAGE_DIR=./uploads

# AI Integration - Google Gemini (Google AI Studio free-tier API key)
AI_PROVIDER=gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Anthropic provider
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# File Upload Limits
MAX_UPLOAD_SIZE=10MB
MAX_REQUEST_SIZE=15MB

# SMTP Mail Configuration (Optional for email verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
